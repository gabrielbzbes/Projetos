CREATE TABLE Clientes (
    tipcliente INTEGER PRIMARY KEY,
    endcliente VARCHAR(60),
    telcliente CHAR(11),
    emailcliente VARCHAR(50),
    nomecliente VARCHAR(40),
    cpfcliente CHAR(14)
);

CREATE TABLE ANIMAL (
    tipanimal INTEGER PRIMARY KEY,
    tipcliente INTEGER,
    nomeanimal VARCHAR(20),
    especanimal VARCHAR(20),
    racaanimal VARCHAR(20),
    sexoanimal VARCHAR(10),
    dataanimal DATE,
    pesoanimal DECIMAL(10,2),
    FOREIGN KEY (tipcliente) REFERENCES Clientes(tipcliente)
);

CREATE TABLE veterinario (
    tipvet INTEGER PRIMARY KEY,
    vetnome VARCHAR(40),
    vetcrmv VARCHAR(10),
    vetespec VARCHAR(25),
    vettel CHAR(11),
    vetmail VARCHAR(50)
);

CREATE TABLE Consulta (
    tipconsulta INTEGER PRIMARY KEY,
    tipanimal INTEGER,
    tipvet INTEGER,
    dataconsulta DATE,
    horaconsulta TIME,
    motivo VARCHAR(100),
    diagnostico VARCHAR(200),
    observacoes VARCHAR(300),
    FOREIGN KEY (tipanimal) REFERENCES Animal(tipanimal),
    FOREIGN KEY (tipvet) REFERENCES Veterinario(tipvet)
);

