    Clientes.nomecliente,
    Animal.nomeanimal
FROM Clientes, Animal
WHERE Clientes.tipcliente = Animal.tipcliente;

SELECT
    Clientes.nomecliente,
    Animal.nomeanimal,
    Consulta.dataconsulta,
    Consulta.horaconsulta,
    Consulta.motivo,
    Consulta.diagnostico
FROM Clientes, Animal, Consulta
WHERE Clientes.tipcliente = Animal.tipcliente
AND Animal.tipanimal = Consulta.tipanimal;

